{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lbrty",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "node scripts/build.mjs"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "routes": [
    {
      "pattern": "lbrty.nl",
      "custom_domain": true
    },
    {
      "pattern": "www.lbrty.nl",
      "custom_domain": true
    }
  ]
}
